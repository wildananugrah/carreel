# ===========================================
# Driver App — Backend (.env)
# ===========================================

# --- Database (required) ---
DATABASE_URL=postgresql://carreel:carreel_secret@localhost:5432/carreel_driver

# --- Server ---
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_SECRET=dev-jwt-secret
JWT_EXPIRES_IN=7d

# --- Object storage ---
# Multi-target mode (scale up without migrating old media — see docs/storage-targets.md):
#   STORAGE_TARGETS='[{"id":"s3-2026","kind":"s3","region":"ap-southeast-1","bucket":"bucket-rsmcb1","accessKeyId":"env:S3_ACCESS_KEY_ID","secretAccessKey":"env:S3_SECRET_ACCESS_KEY"}]'
#   STORAGE_ACTIVE_TARGET=s3-2026   # new uploads land here
#   STORAGE_DEFAULT_TARGET=s3-2026  # where rows with a NULL storageTarget live
#
# Leave STORAGE_TARGETS unset to keep the legacy single-target setup below,
# which is synthesized into one target with the id "s3-primary".

# --- AWS S3 / Lightsail Object Storage (legacy single target) ---
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=bucket-rsmcb1
# S3_ENDPOINT=              # Optional: custom endpoint (leave blank for standard AWS S3)
# S3_FORCE_PATH_STYLE=false # Set true only for local S3-compatible servers (e.g. MinIO)

# --- WebSocket ---
WEBSOCKET_URL=http://localhost:3003

# --- AI (Google Gemini) ---
# Leave GEMINI_API_KEY empty to use stub provider (no real AI calls)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash          # default model for all steps
AI_ENABLED=true

# --- Per-step model overrides (optional) ---
# Leave unset to use GEMINI_MODEL for that step.
# Use a stronger (Pro) model only where quality matters most to save cost.
# GEMINI_MODEL_UNIT_IDENTIFICATION=gemini-2.5-flash
# GEMINI_MODEL_VIN_NUMBER=gemini-2.5-flash
# GEMINI_MODEL_SPEEDOMETER=gemini-2.5-pro
# GEMINI_MODEL_BODY_INSPECTION=gemini-2.5-pro

# --- AI Thresholds ---
KM_TOLERANCE=20
LOW_FUEL_THRESHOLD_PCT=15
DAMAGE_SIMILARITY_THRESHOLD=0.9

# --- BODY_INSPECTION ensemble (UNION + dedup) ---
# Number of times Pass 2 (damage detection) runs per body inspection.
# Damages from all runs are UNIONed and deduplicated — exact duplicates
# (same panel family + damageType + close timestamps) collapse into one,
# but anything seen by any run survives. Trades cost for recall, since at
# temperature=1.0 each individual run misses different things.
# 1 = single call (cheapest, no dedup). Each extra run is ~1× the per-step
# Gemini cost.
BODY_INSPECTION_ENSEMBLE_RUNS=3
# Two damages from different runs collapse as the same physical damage if
# their videoTimestamps are within this many seconds.
BODY_INSPECTION_ENSEMBLE_TIMESTAMP_TOLERANCE_SEC=5

# --- Upload ---
CHUNKED_UPLOAD_CHUNK_SIZE_MB=5

# --- Observability ---
SERVICE_NAME=driver-backend
LOKI_URL=http://localhost:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
