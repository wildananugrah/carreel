# ===========================================
# Driver App — Backend (.env)
# ===========================================

# --- Database (required) ---
DATABASE_URL=postgresql://carreel:carreel_secret@localhost:5432/carreel_driver

# --- Server ---
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_SECRET=dev-jwt-secret
JWT_EXPIRES_IN=7d

# --- AWS S3 / Lightsail Object Storage ---
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=bucket-rsmcb1
# S3_ENDPOINT=              # Optional: custom endpoint (leave blank for standard AWS S3)
# S3_FORCE_PATH_STYLE=false # Set true only for local S3-compatible servers (e.g. MinIO)

# --- WebSocket ---
WEBSOCKET_URL=http://localhost:3003

# --- AI (Google Gemini) ---
# Leave GEMINI_API_KEY empty to use stub provider (no real AI calls)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_ENABLED=true

# --- AI Thresholds ---
KM_TOLERANCE=20
LOW_FUEL_THRESHOLD_PCT=15
DAMAGE_SIMILARITY_THRESHOLD=0.9

# --- BODY_INSPECTION ensemble (UNION + dedup) ---
# Number of times Pass 2 (damage detection) runs per body inspection.
# Damages from all runs are UNIONed and deduplicated — exact duplicates
# (same panel family + damageType + close timestamps) collapse into one,
# but anything seen by any run survives. Trades cost for recall, since at
# temperature=1.0 each individual run misses different things.
# 1 = single call (cheapest, no dedup). Each extra run is ~1× the per-step
# Gemini cost.
BODY_INSPECTION_ENSEMBLE_RUNS=3
# Two damages from different runs collapse as the same physical damage if
# their videoTimestamps are within this many seconds.
BODY_INSPECTION_ENSEMBLE_TIMESTAMP_TOLERANCE_SEC=5

# --- Upload ---
CHUNKED_UPLOAD_CHUNK_SIZE_MB=5

# --- Observability ---
SERVICE_NAME=driver-backend
LOKI_URL=http://localhost:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
