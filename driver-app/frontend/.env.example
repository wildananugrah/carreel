# ===========================================
# Driver App — Frontend (.env)
# ===========================================

# --- Dev Server ---
VITE_PORT=5173
VITE_API_URL=http://localhost:3001
# VITE_ALLOWED_HOSTS=

# --- Upload Source ---
# "both" = camera + file picker, "camera" = camera only, "file" = file picker only
VITE_UPLOAD_SOURCE=both

# --- Video Recording ---
VITE_VIDEO_MIN_DURATION=30
VITE_VIDEO_MAX_DURATION=180

# --- Display Thresholds ---
VITE_KM_TOLERANCE=20

# --- Features ---
VITE_DAMAGE_SEEK_ENABLED=false
