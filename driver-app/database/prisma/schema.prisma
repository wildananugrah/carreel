generator client {
  provider = "prisma-client"
  output   = "../../backend/src/generated/prisma"
}

generator plannerClient {
  provider = "prisma-client"
  output   = "../../../planner-app/backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========================
// USERS & AUTH
// ========================

enum UserRole {
  DRIVER
  PLANNER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  systemRole SystemRole @default(USER)

  inspections Inspection[]       @relation("DriverInspections")
  reviews     InspectionReview[] @relation("ReviewerReviews")
  auditLogs   AuditLog[]

  projectMemberships         ProjectMember[]
  driverAssignmentsAsDriver  DriverAssignment[] @relation("DriverAssignments_driver")
  driverAssignmentsAsPlanner DriverAssignment[] @relation("DriverAssignments_planner")

  damageMarkersEdited  DamageMarker[]   @relation("DamageMarkerEditedBy")
  damageMarkersDeleted DamageMarker[]   @relation("DamageMarkerDeletedBy")
  damageAuditLogs      DamageAuditLog[]

  @@map("users")
}

// ========================
// UNITS (VEHICLES)
// ========================

enum UnitStatus {
  ACTIVE
  MAINTENANCE
  DECOMMISSIONED
}

model Unit {
  id           String     @id @default(uuid())
  licensePlate String     @unique
  make         String?
  model        String?
  type         String?
  color        String?
  vin          String?    @unique
  lastKnownKm  Int?
  status       UnitStatus @default(ACTIVE)
  company      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  inspections Inspection[]

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@map("units")
}

// ========================
// INSPECTIONS
// ========================

enum TripType {
  PRE_TRIP
  POST_TRIP
}

enum ProjectRole {
  PROJECT_ADMIN
  PLANNER
  DRIVER
}

enum SystemRole {
  SUPER_ADMIN
  USER
  CARREEL_DRIVER_SUPPORT
}

enum InspectionStatus {
  DRAFT
  PENDING_AI
  AI_COMPLETE
  UNDER_REVIEW
  APPROVED
  REJECTED
  FLAGGED
}

model Inspection {
  id                     String           @id @default(uuid())
  driverId               String
  unitId                 String?
  tripType               TripType
  status                 InspectionStatus @default(DRAFT)
  linkedInspectionId     String?          @unique
  startedAt              DateTime         @default(now())
  completedAt            DateTime?
  latitude               Float?
  longitude              Float?
  signatureKey           String?
  signatureStorageTarget String?
  signerName             String?
  signedAt               DateTime?
  driverComment          String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  driver           User               @relation("DriverInspections", fields: [driverId], references: [id])
  unit             Unit?              @relation(fields: [unitId], references: [id])
  linkedInspection Inspection?        @relation("LinkedInspection", fields: [linkedInspectionId], references: [id])
  linkedFrom       Inspection?        @relation("LinkedInspection")
  steps            InspectionStep[]
  reviews          InspectionReview[]
  auditLogs        AuditLog[]
  damageAuditLogs  DamageAuditLog[]
  alerts           Alert[]
  telemetryData    TelemetryData[]
  uploadSessions   UploadSession[]

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@map("inspections")
}

// ========================
// INSPECTION STEPS
// ========================

enum StepType {
  UNIT_IDENTIFICATION
  VIN_NUMBER
  SPEEDOMETER
  BODY_INSPECTION
}

enum StepStatus {
  PENDING
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

model InspectionStep {
  id                 String     @id @default(uuid())
  inspectionId       String
  stepType           StepType
  status             StepStatus @default(PENDING)
  /// How many times the driver has re-run AI analysis for this step after a
  /// verification failure. Capped at 2 by InspectionService.retryStepAnalysis;
  /// surfaced to planners so a pass-on-retry stays visible.
  analysisRetryCount Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  inspection Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  mediaFiles MediaFile[]
  aiAnalysis AIAnalysis?

  projectId String

  @@unique([inspectionId, stepType])
  @@index([projectId])
  @@map("inspection_steps")
}

// ========================
// MEDIA FILES
// ========================

enum MediaType {
  IMAGE
  VIDEO
}

enum BodyInspectionMode {
  VIDEO
  PHOTOS_8SIDE
}

enum BodySide {
  FRONT
  FRONT_RIGHT
  RIGHT
  BACK_RIGHT
  BACK
  BACK_LEFT
  LEFT
  FRONT_LEFT
}

model MediaFile {
  id              String    @id @default(uuid())
  stepId          String
  fileName        String
  mimeType        String
  fileSize        Int
  minioKey        String
  minioBucket     String
  storageTarget   String?
  mediaType       MediaType
  bodySide        BodySide?
  latitude        Float?
  longitude       Float?
  capturedAt      DateTime
  durationSeconds Float?
  createdAt       DateTime  @default(now())

  step          InspectionStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  damageMarkers DamageMarker[]
  aiAnalyses    AIAnalysis[]

  projectId String

  @@index([projectId])
  @@index([storageTarget])
  @@map("media_files")
}

// ========================
// AI ANALYSIS RESULTS
// ========================

enum AIAnalysisStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model AIAnalysis {
  id               String           @id @default(uuid())
  stepId           String           @unique
  mediaFileId      String?
  aiModel          String
  promptUsed       String
  rawResponse      String
  structuredData   Json?
  confidenceScore  Float?
  processingTimeMs Int
  inputTokens      Int?
  outputTokens     Int?
  thinkingTokens   Int?
  totalTokens      Int?
  status           AIAnalysisStatus @default(SUCCESS)
  errorMessage     String?
  createdAt        DateTime         @default(now())

  step      InspectionStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  mediaFile MediaFile?     @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)

  projectId String

  @@index([projectId])
  @@map("ai_analyses")
}

// ========================
// DAMAGE MARKERS
// ========================

enum DamageSeverity {
  MINOR
  MODERATE
  MAJOR
}

enum DamageSource {
  AI
  DRIVER_ADDED
}

enum DamageVerificationStatus {
  NOT_REQUIRED
  PENDING
  PASSED
  FAILED_SCREEN_CAPTURE
  FAILED_VEHICLE_MISMATCH
  FAILED_OTHER
}

enum DamageAuditAction {
  CREATED
  EDITED
  DELETED
  RESTORED
}

model DamageMarker {
  id             String         @id @default(uuid())
  mediaFileId    String
  damageType     String
  severity       DamageSeverity
  description    String
  location       String?
  videoTimestamp Float?
  boundingBox    Json?
  isNewDamage    Boolean        @default(false)
  createdAt      DateTime       @default(now())

  // Provenance + audit trail. AI-detected damages stay at default values
  // for these columns; DRIVER_ADDED ones go through inline AI verification
  // before being saved as PASSED, and edits snapshot the original AI value
  // so the planner can see what the driver changed.
  source              DamageSource             @default(AI)
  verificationStatus  DamageVerificationStatus @default(NOT_REQUIRED)
  verificationReason  String?
  originalSeverity    DamageSeverity?
  originalLocation    String?
  originalDescription String?
  editedAt            DateTime?
  editedById          String?
  deletedAt           DateTime?
  deletedById         String?

  mediaFile MediaFile        @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  editedBy  User?            @relation("DamageMarkerEditedBy", fields: [editedById], references: [id])
  deletedBy User?            @relation("DamageMarkerDeletedBy", fields: [deletedById], references: [id])
  auditLogs DamageAuditLog[]

  projectId String

  @@index([projectId])
  @@index([source])
  @@index([deletedAt])
  @@map("damage_markers")
}

model DamageAuditLog {
  id             String            @id @default(uuid())
  damageMarkerId String
  inspectionId   String
  actorId        String
  action         DamageAuditAction
  before         Json?
  after          Json?
  createdAt      DateTime          @default(now())

  damageMarker DamageMarker @relation(fields: [damageMarkerId], references: [id], onDelete: Cascade)
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id])

  projectId String

  @@index([damageMarkerId])
  @@index([inspectionId])
  @@index([projectId])
  @@index([createdAt])
  @@map("damage_audit_logs")
}

// ========================
// TELEMETRY DATA
// ========================

model TelemetryData {
  id             String   @id @default(uuid())
  inspectionId   String
  odometerKm     Int?
  fuelLevelPct   Float?
  dashboardMatch Boolean?
  kmReasonable   Boolean?
  previousKm     Int?
  kmDelta        Int?
  createdAt      DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  projectId String

  @@index([inspectionId])
  @@index([projectId])
  @@map("telemetry_data")
}

// ========================
// PLANNER REVIEWS
// ========================

enum ReviewDecision {
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

model InspectionReview {
  id           String         @id @default(uuid())
  inspectionId String
  reviewerId   String
  decision     ReviewDecision
  notes        String?
  createdAt    DateTime       @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id])
  reviewer   User       @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  projectId String

  @@index([projectId])
  @@map("inspection_reviews")
}

// ========================
// ALERTS
// ========================

enum AlertType {
  NEW_DAMAGE_DETECTED
  KM_ANOMALY
  LOW_FUEL
  AI_FAILURE
  HIGH_SEVERITY_DAMAGE
  SCREEN_RECAPTURE
  VEHICLE_MISMATCH
}

model Alert {
  id           String    @id @default(uuid())
  inspectionId String
  alertType    AlertType
  message      String
  isRead       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([isRead, createdAt])
  @@index([inspectionId])
  @@index([projectId])
  @@map("alerts")
}

// ========================
// AUDIT LOG
// ========================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  inspectionId String?
  action       String
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id])
  inspection Inspection? @relation(fields: [inspectionId], references: [id])

  projectId String?

  @@index([action])
  @@index([userId])
  @@index([inspectionId])
  @@index([createdAt])
  @@index([projectId])
  @@map("audit_logs")
}

// ========================
// UPLOAD SESSIONS (chunked video upload)
// ========================

enum UploadSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

model UploadSession {
  id              String              @id @default(uuid())
  driverId        String
  inspectionId    String
  stepId          String
  minioUploadId   String
  minioKey        String
  minioBucket     String
  storageTarget   String?
  fileName        String
  mimeType        String
  fileSize        Int
  chunkSize       Int
  totalChunks     Int
  status          UploadSessionStatus @default(IN_PROGRESS)
  latitude        Float?
  longitude       Float?
  capturedAt      DateTime
  durationSeconds Float?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  inspection Inspection     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  parts      UploadedPart[]

  @@index([driverId, status])
  @@index([inspectionId])
  @@map("upload_sessions")
}

model UploadedPart {
  id         String   @id @default(uuid())
  sessionId  String
  partNumber Int
  etag       String
  size       Int
  createdAt  DateTime @default(now())

  session UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, partNumber])
  @@map("uploaded_parts")
}

// ========================
// OUTBOX EVENTS (for event-driven sync to planner-app)
// ========================

enum OutboxEventStatus {
  PENDING
  SENT
  FAILED
}

model OutboxEvent {
  id        String            @id @default(uuid())
  eventType String
  payload   Json
  status    OutboxEventStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@index([status, createdAt])
  @@map("outbox_events")
}

// ========================
// WORKSPACES & PROJECTS (multi-tenancy)
// ========================

model Workspace {
  id                       String             @id @default(uuid())
  name                     String             @unique
  displayName              String
  bodyInspectionMode       BodyInspectionMode @default(VIDEO)
  additionalBodyPhotoCount Int                @default(0)
  /// Which of the 8 body sides a driver MUST capture in PHOTOS_8SIDE mode.
  /// Sides not listed here still render a capture slot, but are optional and
  /// do not block submit. Defaults to all 8 so existing workspaces keep their
  /// current behavior. Ignored entirely when bodyInspectionMode is VIDEO.
  requiredBodySides        BodySide[]         @default([FRONT, FRONT_RIGHT, RIGHT, BACK_RIGHT, BACK, BACK_LEFT, LEFT, FRONT_LEFT])
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  projects Project[]

  @@map("workspaces")
}

model Project {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  assignments DriverAssignment[]
  units       Unit[]
  inspections Inspection[]
  alerts      Alert[]

  @@unique([workspaceId, name])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model DriverAssignment {
  id         String   @id @default(uuid())
  projectId  String
  driverId   String
  plannerId  String
  assignedBy String
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  driver  User    @relation("DriverAssignments_driver", fields: [driverId], references: [id], onDelete: Cascade)
  planner User    @relation("DriverAssignments_planner", fields: [plannerId], references: [id], onDelete: Cascade)

  @@unique([projectId, driverId, plannerId])
  @@index([plannerId, projectId])
  @@index([driverId, projectId])
  @@map("driver_assignments")
}
