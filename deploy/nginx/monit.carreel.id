server {
  listen 443 ssl;
  listen [::]:443 ssl;
  ssl_certificate /etc/letsencrypt/live/monit.carreel.id/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/monit.carreel.id/privkey.pem;
  # server_name 154.56.61.109;
  client_max_body_size 1024M;
  server_name monit.carreel.id;
  
  location / {
      proxy_pass http://localhost:3000/;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection upgrade;
      proxy_set_header Accept-Encoding gzip;
  }
}

server {
    if ($host = monit.carreel.id) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80 ;
    listen [::]:80 ;
    server_name monit.carreel.id;
    return 404; # managed by Certbot
}