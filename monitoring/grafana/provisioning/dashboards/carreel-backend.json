{
  "uid": "carreel-backend",
  "title": "Carreel Backend",
  "tags": ["carreel", "backend", "loki", "pgboss"],
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
        "definition": "",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "app",
        "options": [],
        "query": { "label": "app", "stream": "", "type": 1 },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Unique Users",
      "description": "Count of distinct authenticated users in the selected time range",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "count(count by (user) (count_over_time({app=~\"$app\"} |~ `\\[user:` | pattern `<_> [user:<user>] <_>` | user != `anonymous` [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Authenticated Requests",
      "description": "Total requests from logged-in users",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "count_over_time({app=~\"$app\"} |~ `\\[user:` | pattern `<_> [user:<user>] <_>` | user != `anonymous` [$__range])",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Users",
      "description": "List of users with their request count",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum by (user) (count_over_time({app=~\"$app\"} |~ `\\[user:` | pattern `<_> [user:<user>] <_>` | user != `anonymous` [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "user" }, "properties": [{ "id": "displayName", "value": "User ID" }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Requests" }] }
        ]
      },
      "transformations": [
        { "id": "sortBy", "options": { "sort": [{ "field": "Value", "desc": true }] } }
      ]
    },
    {
      "id": 4,
      "title": "Total Requests",
      "description": "Total HTTP requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "count_over_time({app=~\"$app\"} |~ `\\[txn:` [$__range])",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Error Count",
      "description": "Total error log lines",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "count_over_time({app=~\"$app\"} |~ `\\[ERROR\\]` [$__range])",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Unique Users Over Time",
      "description": "Distinct users per 5-minute bucket",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "count by (user) (count_over_time({app=~\"$app\"} |~ `\\[user:` | pattern `<_> [user:<user>] <_>` | user != `anonymous` [5m]))",
          "refId": "A",
          "legendFormat": "{{user}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 0,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Top Active Users",
      "description": "Users ranked by number of requests",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "topk(10, sum by (user) (count_over_time({app=~\"$app\"} |~ `\\[user:` | pattern `<_> [user:<user>] <_>` | user != `anonymous` [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Log Volume (per minute)",
      "description": "Number of log lines per minute by level",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum(count_over_time({app=~\"$app\"} |~ `\\[INFO\\]` [1m]))",
          "refId": "A",
          "legendFormat": "INFO"
        },
        {
          "expr": "sum(count_over_time({app=~\"$app\"} |~ `\\[WARN\\]` [1m]))",
          "refId": "B",
          "legendFormat": "WARN"
        },
        {
          "expr": "sum(count_over_time({app=~\"$app\"} |~ `\\[ERROR\\]` [1m]))",
          "refId": "C",
          "legendFormat": "ERROR"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 0,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "INFO" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "WARN" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },
    {
      "id": 9,
      "title": "HTTP Requests by Status",
      "description": "Request count grouped by HTTP status code",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({app=~\"$app\"} |~ `\\[txn:` | regexp `(?P<method>GET|POST|PUT|PATCH|DELETE) \\S+ (?P<status>\\d+) ` [1m]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 0,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "200" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "201" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "super-light-green" } }] },
          { "matcher": { "id": "byName", "options": "400" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "401" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "404" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "light-orange" } }] },
          { "matcher": { "id": "byName", "options": "500" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },
    {
      "id": 10,
      "title": "Top Endpoints",
      "description": "Most requested endpoints",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "topk(100, sum by (method, uri) (count_over_time({app=~\"$app\"} |~ `\\[txn:` | regexp `(?P<method>GET|POST|PUT|PATCH|DELETE) (?P<uri>\\S+) \\d+ ` [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "method" }, "properties": [{ "id": "displayName", "value": "Method" }, { "id": "custom.width", "value": 80 }] },
          { "matcher": { "id": "byName", "options": "uri" }, "properties": [{ "id": "displayName", "value": "Endpoint" }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Requests" }] }
        ]
      },
      "transformations": [
        { "id": "sortBy", "options": { "sort": [{ "field": "Value", "desc": true }] } }
      ]
    },
    {
      "id": 11,
      "title": "Response Time",
      "description": "Response times extracted from logs (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "quantile_over_time(0.5, {app=~\"$app\"} |~ `\\[txn:` | regexp `(?P<time>\\d+)ms$` | unwrap time [1m]) by ()",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "quantile_over_time(0.95, {app=~\"$app\"} |~ `\\[txn:` | regexp `(?P<time>\\d+)ms$` | unwrap time [1m]) by ()",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "quantile_over_time(0.99, {app=~\"$app\"} |~ `\\[txn:` | regexp `(?P<time>\\d+)ms$` | unwrap time [1m]) by ()",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "ms",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Error Logs",
      "description": "All ERROR and WARN level logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "{app=~\"$app\"} |~ `\\[(ERROR|WARN)\\]`",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 13,
      "title": "All Logs",
      "description": "Complete log stream",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 46 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "{app=~\"$app\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 100,
      "title": "--- Job Queue Monitoring ---",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 14,
      "title": "Queue Depth",
      "description": "Jobs waiting to be processed (created + retry)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 59 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"Queue Depth\" FROM pgboss.job WHERE state IN ('created', 'retry');",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Active Jobs",
      "description": "Jobs currently being processed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 59 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"Active Jobs\" FROM pgboss.job WHERE state = 'active';",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Completed (24h)",
      "description": "Jobs successfully completed in the last 24 hours",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 59 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"Completed\" FROM pgboss.job WHERE state = 'completed' AND completed_on > now() - interval '24 hours';",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Failed (24h)",
      "description": "Jobs that failed in the last 24 hours",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 59 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"Failed\" FROM pgboss.job WHERE state = 'failed' AND completed_on > now() - interval '24 hours';",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "Job Throughput",
      "description": "Completed jobs per 5-minute bucket",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 63 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT\n  $__timeGroup(completed_on, '5m') AS time,\n  count(*) AS \"Completed\"\nFROM pgboss.job\nWHERE state = 'completed'\n  AND $__timeFilter(completed_on)\nGROUP BY 1\nORDER BY 1;",
          "refId": "A",
          "format": "time_series"
        },
        {
          "rawSql": "SELECT\n  $__timeGroup(completed_on, '5m') AS time,\n  count(*) AS \"Failed\"\nFROM pgboss.job\nWHERE state = 'failed'\n  AND $__timeFilter(completed_on)\nGROUP BY 1\nORDER BY 1;",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 0,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Completed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },
    {
      "id": 19,
      "title": "Processing Duration",
      "description": "Job processing time percentiles (p50, p95, p99) in seconds",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 63 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT\n  $__timeGroup(completed_on, '5m') AS time,\n  percentile_cont(0.50) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (completed_on - started_on))) AS \"p50\",\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (completed_on - started_on))) AS \"p95\",\n  percentile_cont(0.99) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (completed_on - started_on))) AS \"p99\"\nFROM pgboss.job\nWHERE state = 'completed'\n  AND started_on IS NOT NULL\n  AND $__timeFilter(completed_on)\nGROUP BY 1\nORDER BY 1;",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "s",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Jobs by Step Type",
      "description": "Job count grouped by step type and state",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 71 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT\n  COALESCE(data->>'stepType', 'unknown') AS \"Step Type\",\n  count(*) FILTER (WHERE state = 'completed') AS \"Completed\",\n  count(*) FILTER (WHERE state = 'failed') AS \"Failed\",\n  count(*) FILTER (WHERE state = 'active') AS \"Active\",\n  count(*) FILTER (WHERE state IN ('created', 'retry')) AS \"Pending\"\nFROM pgboss.job\nWHERE $__timeFilter(created_on)\nGROUP BY 1\nORDER BY \"Completed\" DESC;",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" },
        "xTickLabelRotation": 0,
        "stacking": "normal",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "showValue": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Completed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "Active" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "Pending" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      }
    },
    {
      "id": 21,
      "title": "Recent Failed Jobs",
      "description": "Last 20 failed jobs with error details",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 71 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT\n  created_on AS \"Time\",\n  data->>'stepType' AS \"Step Type\",\n  data->>'inspectionId' AS \"Inspection ID\",\n  COALESCE(output->>'message', output->>'error', 'N/A') AS \"Error\",\n  retry_count AS \"Retries\",\n  retry_limit AS \"Max Retries\"\nFROM pgboss.job\nWHERE state = 'failed'\nORDER BY created_on DESC\nLIMIT 20;",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Time", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Time" }, "properties": [{ "id": "custom.width", "value": 180 }] },
          { "matcher": { "id": "byName", "options": "Step Type" }, "properties": [{ "id": "custom.width", "value": 160 }] },
          { "matcher": { "id": "byName", "options": "Retries" }, "properties": [{ "id": "custom.width", "value": 70 }] },
          { "matcher": { "id": "byName", "options": "Max Retries" }, "properties": [{ "id": "custom.width", "value": 90 }] }
        ]
      }
    }
  ]
}
