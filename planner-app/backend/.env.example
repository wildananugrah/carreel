# ===========================================
# Planner App — Backend (.env)
# ===========================================

# --- Database (required, same DB as driver-app) ---
DATABASE_URL=postgresql://carreel:carreel_secret@localhost:5432/carreel_driver

# --- Server ---
PORT=3002
ALLOWED_ORIGINS=http://localhost:5174

# --- Auth ---
JWT_SECRET=dev-jwt-secret
JWT_EXPIRES_IN=7d

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=carreel
MINIO_SECRET_KEY=carreel_secret
MINIO_USE_SSL=false

# --- WebSocket ---
WEBSOCKET_URL=http://localhost:3003

# --- Observability ---
SERVICE_NAME=planner-backend
LOKI_URL=http://localhost:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
