# ===========================================
# Planner App — Backend (.env)
# ===========================================

# --- Database (required, same DB as driver-app) ---
DATABASE_URL=postgresql://carreel:carreel_secret@localhost:5432/carreel_driver

# --- Server ---
PORT=3002
ALLOWED_ORIGINS=http://localhost:5174

# --- Auth ---
JWT_SECRET=dev-jwt-secret
JWT_EXPIRES_IN=7d

# --- Object storage ---
# Multi-target mode (scale up without migrating old media — see docs/storage-targets.md):
#   STORAGE_TARGETS='[{"id":"s3-2026","kind":"s3","region":"ap-southeast-1","bucket":"bucket-rsmcb1","accessKeyId":"env:S3_ACCESS_KEY_ID","secretAccessKey":"env:S3_SECRET_ACCESS_KEY"}]'
#   STORAGE_ACTIVE_TARGET=s3-2026   # new uploads land here
#   STORAGE_DEFAULT_TARGET=s3-2026  # where rows with a NULL storageTarget live
#
# Leave STORAGE_TARGETS unset to keep the legacy single-target setup below,
# which is synthesized into one target with the id "s3-primary".

# --- AWS S3 / Lightsail Object Storage (legacy single target) ---
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=bucket-rsmcb1
# S3_ENDPOINT=              # Optional: custom endpoint (leave blank for standard AWS S3)
# S3_FORCE_PATH_STYLE=false # Set true only for local S3-compatible servers (e.g. MinIO)

# --- WebSocket ---
WEBSOCKET_URL=http://localhost:3003

# --- Observability ---
SERVICE_NAME=planner-backend
LOKI_URL=http://localhost:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
