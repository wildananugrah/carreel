{
  "name": "carreel-planner-backend",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check src tests",
    "lint:fix": "bunx biome check --write src tests",
    "validate": "bun run typecheck && bun run lint && bun test",
    "pm2:start": "pm2 start pm2.config.cjs",
    "pm2:stop": "pm2 stop planner-backend",
    "pm2:logs": "pm2 logs planner-backend"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.54.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "hono": "^4.7.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.0",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "^1.3.10",
    "@types/jsonwebtoken": "^9.0.9",
    "prisma": "^7.0.0",
    "typescript": "^5.8.0"
  }
}
